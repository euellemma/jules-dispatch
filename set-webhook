#!/bin/bash

# Set Telegram webhook to point to this Convex deployment

ENV_FILE=".env.local"

TELEGRAM_BOT_TOKEN=$(grep '^TELEGRAM_BOT_TOKEN=' "$ENV_FILE" | cut -d '=' -f2- | tr -d '"\r')
SITE_URL=$(grep '^CONVEX_SITE_URL=' "$ENV_FILE" | cut -d '=' -f2- | tr -d '"\r')

if [ -z "$TELEGRAM_BOT_TOKEN" ]; then
    echo "Error: TELEGRAM_BOT_TOKEN not found in $ENV_FILE"
    exit 1
fi

if [ -z "$SITE_URL" ]; then
    echo "Error: CONVEX_SITE_URL not found in $ENV_FILE"
    exit 1
fi

WEBHOOK_URL="${SITE_URL}/telegram"
echo "Setting Telegram webhook to: $WEBHOOK_URL"

curl -s "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook?url=${WEBHOOK_URL}" | jq .

echo ""
echo "Checking current webhook info:"
curl -s "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getWebhookInfo" | jq .
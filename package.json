{
  "name": "jules-dispatch",
  "version": "0.1.0",
  "description": "Telegram bot powered by Jules AI agent",
  "type": "module",
  "private": false,
  "bin": {
    "jules-dispatch": "cli/bin.js"
  },
  "files": [
    "cli",
    "dist/cli",
    "dist/shared",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run dev:convex",
    "dev:convex": "npx convex dev",
    "dev:logged": "node scripts/logs.js",
    "logs": "node scripts/logs.js",
    "logs:prod": "node scripts/logs.js -- --prod",
    "dev:web": "cd web && npm run dev",
    "build:cli": "tsc --project tsconfig.cli.json",
    "build:web": "cd web && npm run build",
    "build": "npm run build:cli && npm run build:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && cd web && tsc --noEmit",
    "ci": "npm run typecheck:all && npm run lint",
    "deploy:dev": "npx convex deploy --yes",
    "deploy": "npx @convex-dev/static-hosting deploy --yes",
    "deploy:web": "npm run build:web && npx @convex-dev/static-hosting upload --dist ./web/dist --prod",
    "auth:byok": "echo 'Open settings from Telegram using /connect command'",
    "cli": "npm run build:cli && node dist/cli/index.js",
    "prepublishOnly": "npm run build:cli",
    "tester": "npx tsx --tsconfig tester/tsconfig.json tester/runner.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.x",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsx": "^4.x",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/openai": "^3.0.47",
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@clack/prompts": "^1.1.0",
    "@convex-dev/agent": "^0.6.1",
    "@convex-dev/static-hosting": "^0.1.3",
    "@daytonaio/sdk": "^0.162.0",
    "@google/jules-sdk": "^0.2.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.32.0",
    "@napi-rs/keyring": "^1.2.0",
    "ai": "^6.0.134",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "concurrently": "^9.1.0",
    "convex": "^1.35.1",
    "effect": "^3.21.0",
    "exa-js": "^2.8.0",
    "grammy": "^1.34.0",
    "jszip": "^3.10.1",
    "picocolors": "^1.1.1",
    "quickjs-emscripten-core": "^0.32.0"
  }
}
